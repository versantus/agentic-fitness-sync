# Copy to .env and fill in. .env is git-ignored — never commit it.

# The email you log in to Trainerize with.
TRAINERIZE_EMAIL=you@example.com

# Your coach's Trainerize web address (full URL or just the subdomain).
TRAINERIZE_URL=https://yourcoach.trainerize.com/

# Optional: where the cache and session live (default ~/.trainerize).
# TRAINERIZE_HOME=

# Your password is asked for when you run `trainerize login` (and saved to the macOS Keychain).
# On Linux/Windows you can set TRAINERIZE_PASSWORD in your shell instead — avoid putting it here.
